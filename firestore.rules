// Owner-scoped rules reviewed in Firebase Rules Playground on 2026-10-20.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(email) {
      return request.auth != null && request.auth.token.email == email;
    }
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function administrator() {
      return verified() && exists(/databases/$(database)/documents/administradores/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.enabled == true;
    }
    function billingEnabled() {
      return exists(/databases/$(database)/documents/configuracion/facturacion) &&
        get(/databases/$(database)/documents/configuracion/facturacion).data.enabled == true;
    }
    function paid(uid) {
      return exists(/databases/$(database)/documents/suscripciones/$(uid)) &&
        get(/databases/$(database)/documents/suscripciones/$(uid)).data.planId == 'presupuestos' &&
        get(/databases/$(database)/documents/suscripciones/$(uid)).data.status == 'active' &&
        get(/databases/$(database)/documents/suscripciones/$(uid)).data.paidThrough > request.time;
    }
    function writesEnabled() {
      return !exists(/databases/$(database)/documents/configuracion/seguridad) ||
        get(/databases/$(database)/documents/configuracion/seguridad).data.get('pauseWrites', false) != true;
    }
    function withinQuota(uid, id) {
      let q = getAfter(/databases/$(database)/documents/cuotas/$(uid)).data;
      return q.updatedAt == request.time && q.projectId == id &&
        q.revision == getAfter(/databases/$(database)/documents/cuentas/$(uid)/proyectos/$(id)).data.revision;
    }
    match /cuotas/{uid} {
      allow get: if verified() && request.auth.uid == uid;
      function validQuota() {
        let q = request.resource.data;
        let project = /databases/$(database)/documents/cuentas/$(uid)/proyectos/$(q.projectId);
        let prior = exists(/databases/$(database)/documents/cuotas/$(uid));
        return q.keys().hasAll(['totalProjects', 'saveCount', 'windowStartedAt', 'projectId', 'revision', 'updatedAt']) &&
          q.keys().hasOnly(['totalProjects', 'saveCount', 'windowStartedAt', 'projectId', 'revision', 'updatedAt']) &&
          q.projectId is string && q.projectId.matches('^[A-Za-z0-9_-]{1,100}$') &&
          q.totalProjects is int && q.totalProjects > 0 && q.totalProjects <= 100 && (exists(project) || q.totalProjects <= (paid(uid) ? 100 : 10)) &&
          q.saveCount is int && q.saveCount > 0 && q.saveCount <= 10 &&
          q.windowStartedAt is timestamp && q.updatedAt == request.time &&
          q.totalProjects == (prior ? resource.data.totalProjects : 0) + (exists(project) ? 0 : 1) &&
          ((!prior && q.saveCount == 1 && q.windowStartedAt == request.time) ||
           (prior && request.time >= resource.data.windowStartedAt + duration.value(1, 'd') && q.saveCount == 1 && q.windowStartedAt == request.time) ||
           (prior && request.time < resource.data.windowStartedAt + duration.value(1, 'd') && q.saveCount == resource.data.saveCount + 1 && q.windowStartedAt == resource.data.windowStartedAt)) &&
          getAfter(project).data.revision == q.revision && getAfter(project).data.updatedAt == request.time;
      }
      allow create, update: if verified() && request.auth.uid == uid && writesEnabled() && validQuota();
    }
    function projectAllowed(uid, id) {
      return administrator() || (writesEnabled() && withinQuota(uid, id) && (paid(uid) ||
        (getAfter(/databases/$(database)/documents/accesos/$(uid)).data.claimedAt <= request.time &&
         request.time < getAfter(/databases/$(database)/documents/accesos/$(uid)).data.claimedAt + duration.value(30, 'd'))));
    }
    match /administradores/{uid} { allow get: if verified() && request.auth.uid == uid; }
    match /configuracion/facturacion { allow get: if verified(); }
    match /suscripciones/{uid} { allow get: if verified() && request.auth.uid == uid; }
    match /accesos/{uid} {
      allow get: if verified() && request.auth.uid == uid;
      // Immutable server timestamp; existing trial starts cannot be reset.
      allow create: if verified() && request.auth.uid == uid &&
        request.resource.data.keys().hasAll(['claimedAt']) &&
        request.resource.data.keys().hasOnly(['claimedAt']) && request.resource.data.claimedAt == request.time;
    }
    match /usuarios/{email} {
      // During signup, permit checking that the document is absent.
      // Existing personal data requires a verified email, including on reused emails.
      allow get: if owner(email) &&
        (verified() || !exists(/databases/$(database)/documents/usuarios/$(email)));
      allow create: if owner(email) && verified() && writesEnabled();
      allow update: if owner(email) && verified() && writesEnabled();
    }
    match /costos/{email} {
      allow get: if (email == 'codigos' && verified()) ||
        (owner(email) && (verified() ||
          !exists(/databases/$(database)/documents/costos/$(email))));
      allow create: if email != 'codigos' && owner(email) && verified() && writesEnabled();
      allow update: if email != 'codigos' && owner(email) && verified() && writesEnabled();
    }
    match /cuentas/{uid}/proyectos/{projectId} {
      function access() { return verified() && request.auth.uid == uid; }
      function optionalId(value) { return value == null || (value is string && value.size() > 0 && value.size() <= 100); }
      function validPaymentPlan(p) {
        return p is map && p.keys().hasAll(['count', 'surchargePercent']) && p.keys().hasOnly(['count', 'surchargePercent']) &&
          p.count in [3, 6, 12] && p.surchargePercent is number && p.surchargePercent >= 0 && p.surchargePercent <= 1000;
      }
      function validPaymentOptions(p) {
        return p is map && p.keys().hasAll(['discountPercent', 'installments']) && p.keys().hasOnly(['discountPercent', 'installments']) &&
          p.discountPercent is number && p.discountPercent >= 0 && p.discountPercent <= 100 && p.installments is list && p.installments.size() <= 3 &&
          (p.installments.size() < 1 || validPaymentPlan(p.installments[0])) &&
          (p.installments.size() < 2 || (validPaymentPlan(p.installments[1]) && p.installments[0].count != p.installments[1].count)) &&
          (p.installments.size() < 3 || (validPaymentPlan(p.installments[2]) && p.installments[0].count != p.installments[2].count && p.installments[1].count != p.installments[2].count));
      }
      function validBudget(b) {
        return b is map && b.keys().hasAll(['cliente', 'items', 'total', 'createdAt']) &&
          b.keys().hasOnly(['cliente', 'items', 'total', 'createdAt', 'tipoInmueble', 'paymentOptions']) &&
          b.cliente is string && b.cliente.size() > 0 && b.cliente.size() <= 120 &&
          b.items is list && b.items.size() > 0 && b.items.size() <= 200 &&
          b.total is number && b.total >= 0 && b.total <= 90071992547409 &&
          b.createdAt is string && b.createdAt.size() <= 40 &&
          (!('paymentOptions' in b) || validPaymentOptions(b.paymentOptions)) &&
          (!('tipoInmueble' in b) || (b.tipoInmueble is string && b.tipoInmueble.size() <= 80));
      }
      function validProfile(p) {
        return p == null || (p is map && p.keys().hasAll(['nombre1', 'apellido1', 'cuit1', 'empresa1', 'matricula1', 'telefono1', 'direccion1', 'correo']) &&
          p.keys().hasOnly(['nombre1', 'apellido1', 'cuit1', 'empresa1', 'matricula1', 'telefono1', 'direccion1', 'correo']) &&
          p.nombre1 is string && p.nombre1.size() <= 160 && p.apellido1 is string && p.apellido1.size() <= 160 &&
          p.cuit1 is string && p.cuit1.size() <= 160 && p.empresa1 is string && p.empresa1.size() <= 160 &&
          p.matricula1 is string && p.matricula1.size() <= 160 && p.telefono1 is string && p.telefono1.size() <= 160 &&
          p.direccion1 is string && p.direccion1.size() <= 160 && p.correo is string && p.correo.size() <= 254);
      }
      function validProject(d) {
        return d.keys().hasAll(['schema', 'ownerUid', 'name', 'cliente', 'tipoInmueble', 'total', 'revision', 'createdAt', 'updatedAt', 'sourceLocalId']) &&
          d.keys().hasOnly(['schema', 'ownerUid', 'name', 'cliente', 'tipoInmueble', 'total', 'revision', 'createdAt', 'updatedAt', 'sourceLocalId']) &&
          d.schema == 1 && d.ownerUid == uid && d.name is string && d.name.size() > 0 && d.name.size() <= 120 &&
          d.cliente is string && d.cliente.size() > 0 && d.cliente.size() <= 120 &&
          d.tipoInmueble is string && d.tipoInmueble.size() <= 80 && d.total is number && d.total >= 0 && d.total <= 90071992547409 &&
          d.revision is int && d.revision > 0 && d.revision <= 1000000 && optionalId(d.sourceLocalId) && d.createdAt is timestamp && d.updatedAt == request.time;
      }
      function linkedVersion(d) {
        let v = getAfter(/databases/$(database)/documents/cuentas/$(uid)/proyectos/$(projectId)/versiones/$(string(d.revision))).data;
        return v.revision == d.revision && v.name == d.name && v.budget.cliente == d.cliente &&
          v.budget.get('tipoInmueble', '') == d.tipoInmueble && v.budget.total == d.total && v.createdAt == request.time;
      }
      allow get, list: if access();
      allow create: if access() && projectAllowed(uid, projectId) && validProject(request.resource.data) && request.resource.data.revision == 1 &&
        request.resource.data.createdAt == request.time && linkedVersion(request.resource.data);
      allow update: if access() && projectAllowed(uid, projectId) && validProject(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'cliente', 'tipoInmueble', 'total', 'revision', 'updatedAt']) &&
        request.resource.data.revision == resource.data.revision + 1 && linkedVersion(request.resource.data);
      match /versiones/{versionId} {
        allow get, list: if access();
        allow create: if access() && projectAllowed(uid, projectId) && request.resource.data.keys().hasAll(['schema', 'revision', 'name', 'budget', 'profile', 'createdAt', 'sourceLocalId']) &&
          request.resource.data.keys().hasOnly(['schema', 'revision', 'name', 'budget', 'profile', 'createdAt', 'sourceLocalId', 'sketch']) &&
          // Opaque drawing data: bounded here and parsed/validated by the editor.
          (!('sketch' in request.resource.data) || (request.resource.data.sketch is string && request.resource.data.sketch.size() <= 80000)) &&
          request.resource.data.schema == 1 && request.resource.data.revision is int &&
          versionId == string(request.resource.data.revision) && request.resource.data.revision > 0 && request.resource.data.revision <= 1000000 &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 &&
          validBudget(request.resource.data.budget) && validProfile(request.resource.data.profile) &&
          optionalId(request.resource.data.sourceLocalId) && request.resource.data.createdAt == request.time &&
          (request.resource.data.profile != null || request.resource.data.sourceLocalId != null) &&
          getAfter(/databases/$(database)/documents/cuentas/$(uid)/proyectos/$(projectId)).data.revision == request.resource.data.revision &&
          getAfter(/databases/$(database)/documents/cuentas/$(uid)/proyectos/$(projectId)).data.name == request.resource.data.name;
      }
    }
  }
}
